# Copia este archivo a .env y completa los valores. .env nunca se versiona.

# --- API ---
PORT=3000
DATABASE_FILE=./data/delivery-engine.sqlite
# Clave mínima de operaciones para el header X-Api-Key (ver README, "Control de acceso")
OPS_API_KEY=cambia-esto-por-una-clave-larga
# Zona de operaciones para reportes que no son de un comercio (p. ej. por mensajero)
OPS_TIMEZONE=America/Bogota
CORS_ORIGIN=http://localhost:5173

# --- LLM (Groq) ---
# Key gratuita en https://console.groq.com/keys. Sin key todo funciona menos el chat.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
