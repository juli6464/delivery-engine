{
  "name": "delivery-engine",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "setup": "node -e \"require('fs').existsSync('.env')||require('fs').copyFileSync('.env.example','.env')\" && npm run seed",
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w @delivery-engine/api\" \"npm run dev -w @delivery-engine/web\"",
    "seed": "npm run seed -w @delivery-engine/api",
    "agent:demo": "npm run agent:demo -w @delivery-engine/api",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build -w @delivery-engine/web"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
