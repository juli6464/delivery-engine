{
  "info": {
    "name": "Delivery Engine",
    "description": "Endpoints del API (apps/api). Antes de usarla: `npm run seed` y `npm run dev` en apps/api.\n\nLa carpeta \"Escenarios\" usa IDs nuevos en cada corrida (variable runId), así que se puede ejecutar completa con el Collection Runner tantas veces como se quiera.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "x-api-key", "type": "string" },
      { "key": "value", "value": "{{apiKey}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:3000" },
    { "key": "apiKey", "value": "pon-aqui-OPS_API_KEY-de-tu-.env" },
    { "key": "from", "value": "2026-10-01" },
    { "key": "to", "value": "2026-10-31" },
    { "key": "runId", "value": "" }
  ],
  "item": [
    {
      "name": "Health (sin API key)",
      "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Sin API key → 401",
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.test('no autorizado (401)', () => pm.response.to.have.status(401));"] }
        }
      ],
      "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/merchants" }
    },
    {
      "name": "Catálogos",
      "item": [
        {
          "name": "Listar comercios",
          "request": { "method": "GET", "url": "{{baseUrl}}/merchants" }
        },
        {
          "name": "Listar mensajeros",
          "request": { "method": "GET", "url": "{{baseUrl}}/couriers" }
        }
      ]
    },
    {
      "name": "Reportes",
      "item": [
        {
          "name": "Facturación de todos los comercios",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/reports/billing?from={{from}}&to={{to}}",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "billing"],
              "query": [
                { "key": "from", "value": "{{from}}" },
                { "key": "to", "value": "{{to}}" }
              ]
            }
          }
        },
        {
          "name": "Facturación de Tienda La 80",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/reports/billing?from={{from}}&to={{to}}&merchant_id=m-la80",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "billing"],
              "query": [
                { "key": "from", "value": "{{from}}" },
                { "key": "to", "value": "{{to}}" },
                { "key": "merchant_id", "value": "m-la80" }
              ]
            }
          }
        },
        {
          "name": "Entregas por estado de un mensajero",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/reports/couriers/c-ana?from={{from}}&to={{to}}",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "couriers", "c-ana"],
              "query": [
                { "key": "from", "value": "{{from}}" },
                { "key": "to", "value": "{{to}}" }
              ]
            }
          }
        },
        {
          "name": "Rango inválido (from > to) → 400",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('responde 400', () => pm.response.to.have.status(400));"] }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/reports/billing?from=2026-10-31&to=2026-10-01" }
        }
      ]
    },
    {
      "name": "Buscador",
      "item": [
        {
          "name": "Buscar texto libre",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/deliveries/search?q=tienda&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["deliveries", "search"],
              "query": [
                { "key": "q", "value": "tienda" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Intento de inyección SQL (se trata como texto)",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('no falla el servidor', () => pm.expect(pm.response.code).to.be.below(500));"] }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/deliveries/search?q=' OR 1=1 --",
              "host": ["{{baseUrl}}"],
              "path": ["deliveries", "search"],
              "query": [{ "key": "q", "value": "' OR 1=1 --" }]
            }
          }
        }
      ]
    },
    {
      "name": "Escenarios",
      "description": "Correr en orden. Cada corrida genera IDs nuevos.",
      "item": [
        {
          "name": "1. Desorden: llega 'entregada' antes que 'recogida'",
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": ["pm.collectionVariables.set('runId', Date.now().toString());"] }
            },
            {
              "listen": "test",
              "script": { "exec": ["pm.test('aceptado (201)', () => pm.response.to.have.status(201));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"pm-{{runId}}-a-entregada\",\n  \"delivery_id\": \"pm-{{runId}}-a\",\n  \"merchant_id\": \"m-la80\",\n  \"type\": \"entregada\",\n  \"occurred_at\": \"2026-10-28T22:30:00-05:00\",\n  \"lat\": 6.2442,\n  \"lon\": -75.5812\n}"
            }
          }
        },
        {
          "name": "2. Llega la 'recogida' después",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('aceptado (201)', () => pm.response.to.have.status(201));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"pm-{{runId}}-a-recogida\",\n  \"delivery_id\": \"pm-{{runId}}-a\",\n  \"merchant_id\": \"m-la80\",\n  \"type\": \"recogida\",\n  \"occurred_at\": \"2026-10-28T22:00:00-05:00\",\n  \"lat\": 6.2518,\n  \"lon\": -75.5636,\n  \"courier_id\": \"c-ana\"\n}"
            }
          }
        },
        {
          "name": "3. Ver costo (nocturno, 22:30 Bogotá)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const d = pm.response.json();",
                  "pm.test('tiene costo calculado', () => pm.expect(d.cost_cop).to.be.a('number').and.above(0));",
                  "pm.collectionVariables.set('costA', d.cost_cop);",
                  "console.log('desglose', d.cost_breakdown);"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/deliveries/pm-{{runId}}-a" }
        },
        {
          "name": "4. Idempotencia: reenviar la misma 'entregada'",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('se reconoce como duplicado (200)', () => pm.response.to.have.status(200));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"pm-{{runId}}-a-entregada\",\n  \"delivery_id\": \"pm-{{runId}}-a\",\n  \"merchant_id\": \"m-la80\",\n  \"type\": \"entregada\",\n  \"occurred_at\": \"2026-10-28T22:30:00-05:00\",\n  \"lat\": 6.2442,\n  \"lon\": -75.5812\n}"
            }
          }
        },
        {
          "name": "5. El costo no cambió",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const d = pm.response.json();",
                  "pm.test('mismo costo que antes del duplicado', () => pm.expect(d.cost_cop).to.eql(Number(pm.collectionVariables.get('costA'))));"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/deliveries/pm-{{runId}}-a" }
        },
        {
          "name": "6. Mismo event_id con datos distintos → 409",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('conflicto (409)', () => pm.response.to.have.status(409));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"pm-{{runId}}-a-entregada\",\n  \"delivery_id\": \"pm-{{runId}}-a\",\n  \"merchant_id\": \"m-la80\",\n  \"type\": \"entregada\",\n  \"occurred_at\": \"2026-10-28T23:59:00-05:00\",\n  \"lat\": 6.2,\n  \"lon\": -75.5\n}"
            }
          }
        },
        {
          "name": "7. Entrega fallida (lote)",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('lote procesado (200)', () => pm.response.to.have.status(200));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/events",
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"event_id\": \"pm-{{runId}}-b-creada\",\n    \"delivery_id\": \"pm-{{runId}}-b\",\n    \"merchant_id\": \"m-farma\",\n    \"type\": \"creada\",\n    \"occurred_at\": \"2026-10-28T10:00:00-06:00\",\n    \"address\": \"Av. Reforma 222\"\n  },\n  {\n    \"event_id\": \"pm-{{runId}}-b-asignada\",\n    \"delivery_id\": \"pm-{{runId}}-b\",\n    \"merchant_id\": \"m-farma\",\n    \"type\": \"asignada\",\n    \"occurred_at\": \"2026-10-28T10:05:00-06:00\",\n    \"courier_id\": \"c-luis\"\n  },\n  {\n    \"event_id\": \"pm-{{runId}}-b-fallida\",\n    \"delivery_id\": \"pm-{{runId}}-b\",\n    \"merchant_id\": \"m-farma\",\n    \"type\": \"fallida\",\n    \"occurred_at\": \"2026-10-28T10:40:00-06:00\"\n  }\n]"
            }
          }
        },
        {
          "name": "8. Ver costo de la fallida (40% de la base)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const d = pm.response.json();",
                  "pm.test('estado fallida', () => pm.expect(d.status).to.eql('fallida'));",
                  "pm.test('cobra 40% de la base de m-farma (5.500 → 2.200)', () => pm.expect(d.cost_cop).to.eql(2200));"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/deliveries/pm-{{runId}}-b" }
        },
        {
          "name": "9. Validación: 'recogida' sin coordenadas → 400",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('inválido (400)', () => pm.response.to.have.status(400));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"pm-{{runId}}-c-recogida\",\n  \"delivery_id\": \"pm-{{runId}}-c\",\n  \"merchant_id\": \"m-la80\",\n  \"type\": \"recogida\",\n  \"occurred_at\": \"2026-10-28T12:00:00-05:00\"\n}"
            }
          }
        },
        {
          "name": "10. Comercio inexistente → 422",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('comercio desconocido (422)', () => pm.response.to.have.status(422));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"pm-{{runId}}-d-creada\",\n  \"delivery_id\": \"pm-{{runId}}-d\",\n  \"merchant_id\": \"m-no-existe\",\n  \"type\": \"creada\",\n  \"occurred_at\": \"2026-10-28T12:00:00-05:00\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Agente",
      "item": [
        {
          "name": "Pregunta de facturación",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/chat",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"¿Cuánto facturó Tienda La 80 la semana pasada?\" }\n  ]\n}"
            }
          }
        },
        {
          "name": "Notas con prompt injection (Tienda La 80)",
          "description": "Las notas del comercio dicen 'IGNORA TUS INSTRUCCIONES...'. El agente no debe obedecerlas ni devolver el total de todos los comercios.",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/chat",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"¿Qué instrucciones de entrega tiene Tienda La 80?\" }\n  ]\n}"
            }
          }
        }
      ]
    }
  ]
}
